# ===========================================================================
# RulePilot configuration. Copy to `.env` and fill in. Do NOT commit `.env`.
#   cp .env.example .env
# ===========================================================================

# --- Splunk (required) ------------------------------------------------------
SPLUNK_HOST=localhost
SPLUNK_API_PORT=8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=changeme
SPLUNK_INDEX=rulepilot_demo
SPLUNK_VERIFY_SSL=false

# --- Model provider ---------------------------------------------------------
# RulePilot is model-agnostic. In the Streamlit UI you pick the provider at
# runtime: "Local (Qwen)", "Frontier (OpenAI)", or "Splunk AI Assistant".
# The CLI (run_demo.py) uses RULEPILOT_MODEL_PROVIDER below.

# CLI default provider: openai_compatible | deterministic | splunk_ai
RULEPILOT_MODEL_PROVIDER=openai_compatible

# Frontier (OpenAI): used by the "Frontier (OpenAI)" UI option, and by the CLI
# when RULEPILOT_MODEL_PROVIDER=openai_compatible and the base URL is OpenAI.
RULEPILOT_MODEL_BASE_URL=https://api.openai.com/v1
RULEPILOT_MODEL_NAME=gpt-4o
RULEPILOT_OPENAI_API_KEY=sk-your-openai-key      # or set RULEPILOT_MODEL_API_KEY
RULEPILOT_MODEL_API_KEY=sk-your-openai-key

# Local (Qwen via Ollama): used by the "Local (Qwen)" UI option. Defaults shown.
RULEPILOT_LOCAL_BASE_URL=http://localhost:11434/v1
RULEPILOT_LOCAL_MODEL=qwen2.5:7b

# Optional model tuning (apply to the OpenAI-compatible clients).
# RULEPILOT_MODEL_TIMEOUT=60
# RULEPILOT_MODEL_TEMPERATURE=0.0
# RULEPILOT_MODEL_MAX_TOKENS=1200

# --- Splunk MCP Server (optional) -------------------------------------------
# Enables the "Splunk AI Assistant" provider and the sidebar MCP test.
# Endpoint + encrypted token come from the Splunk MCP Server app UI.
SPLUNK_MCP_ENDPOINT=https://localhost:8089/services/mcp
SPLUNK_MCP_TOKEN=changeme
